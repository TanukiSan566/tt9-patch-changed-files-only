<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	style="@style/TTheme.MainSmall.StatusBar.Wrapper"
	android:defaultFocusHighlightEnabled="false"
	android:focusable="false"
	android:focusableInTouchMode="false">

	<include layout="@layout/panel_status_bar" />

	<!-- Customized build: the left / right indicators of the word row, shown together with the Pinyin row -->
	<TextView
		android:id="@+id/suggestions_arrow_left"
		android:layout_width="28dp"
		android:layout_height="match_parent"
		android:layout_gravity="start|center_vertical"
		android:gravity="center"
		android:text="&#x25C0;&#xFE0E;"
		android:textSize="@dimen/status_bar_text_size"
		android:visibility="gone"
		android:focusable="false"
		android:focusableInTouchMode="false" />

	<TextView
		android:id="@+id/suggestions_arrow_right"
		android:layout_width="28dp"
		android:layout_height="match_parent"
		android:layout_gravity="end|center_vertical"
		android:gravity="center"
		android:text="&#x25B6;&#xFE0E;"
		android:textSize="@dimen/status_bar_text_size"
		android:visibility="gone"
		android:focusable="false"
		android:focusableInTouchMode="false" />

</FrameLayout>
